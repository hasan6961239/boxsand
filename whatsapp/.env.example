# ========= مفاتيح الذكاء الاصطناعي =========
# احصل عليه مجاناً من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# النموذج المستخدم (gemini-2.5-flash هو الأنسب: سريع، يفهم الصوت، وطبقته المجانية سخية)
GEMINI_MODEL=gemini-2.5-flash

# ========= جوجل (التقويم + درايف) =========
# من Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# يتم توليده تلقائياً بتشغيل: npm run auth:google
GOOGLE_REFRESH_TOKEN=

# معرّف مجلد جوجل درايف الذي تُحفظ فيه الملفات الواردة (اتركه فارغاً للجذر)
# تجده في رابط المجلد: drive.google.com/drive/folders/<هذا_هو_المعرّف>
DRIVE_FOLDER_ID=

# معرّف التقويم (اتركه primary للتقويم الأساسي)
CALENDAR_ID=primary

# ========= إعدادات عامة =========
TZ=Africa/Tripoli
LOG_LEVEL=info
