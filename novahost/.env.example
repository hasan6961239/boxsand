# ============================================================================
# NOVA HOST — configuration
# Copy to .env and edit.  .env is git-ignored; never commit real secrets.
# ============================================================================

# ---- Identity --------------------------------------------------------------
APP_NAME=NOVA HOST
# development | production
NODE_ENV=production

# ---- Network ---------------------------------------------------------------
# 0.0.0.0 makes the server reachable from other devices on your Wi-Fi.
# Use 127.0.0.1 if you ONLY want access through the Cloudflare tunnel.
HOST=0.0.0.0

# Dashboard + API.
PORT=8080

# Hosted sites. A SEPARATE PORT IS A SECURITY BOUNDARY, not a preference:
# a different port is a different browser origin, so a site you upload cannot
# read the dashboard's cookies or call the API. Do not set it equal to PORT.
SITES_PORT=8081

# The URL you actually open in a browser. Used for generated links, for the
# Origin allow-list and to decide whether cookies get the Secure flag.
PUBLIC_URL=http://localhost:8080

# ---- Public hostnames (leave empty for LAN-only / quick-tunnel mode) -------
# Hostname the dashboard answers on, e.g. panel.example.com
PANEL_HOST=

# Parent domain for project subdomains, e.g. example.com  ->  my-site.example.com
# Keep this ONE level deep: Cloudflare's free Universal SSL covers *.example.com
# but NOT *.sites.example.com (that needs the paid Advanced Certificate Manager).
SITES_DOMAIN=

# ---- Storage ---------------------------------------------------------------
# Everything that must survive a phone reboot lives under here.
DATA_DIR=./data
DATABASE_PATH=./data/novahost.db
STORAGE_PATH=./data/storage

# ---- Security --------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production with an empty or default value.
SESSION_SECRET=

# How long a login stays valid, in hours. 720 = 30 days.
SESSION_TTL_HOURS=720

# auto | true | false — 'auto' turns on Secure cookies when PUBLIC_URL is https.
SECURE_COOKIES=auto

# Trust X-Forwarded-For / CF-Connecting-IP for the client address.
#
# Default OFF, because the first mode you run in is the local network, where
# nothing sits in front of the server and any device on the Wi-Fi could send a
# forged X-Forwarded-For to get a fresh rate-limit bucket.
#
# Turn it ON once Cloudflare Tunnel is in front, so rate limiting and the
# security log record the real visitor rather than 127.0.0.1.
TRUST_PROXY=false

# ---- Upload and deployment limits (also editable from Settings in the UI) ---
# Cloudflare's free plan rejects request bodies over 100 MB before they ever
# reach your phone, so anything above ~90 here only works over the local network.
MAX_UPLOAD_MB=64
MAX_FILES_PER_DEPLOY=5000
MAX_UNCOMPRESSED_MB=256
MAX_SINGLE_FILE_MB=64
# Refuse archives whose uncompressed size exceeds this multiple of the zip size
# (zip-bomb guard). Normal websites sit far below 20:1.
MAX_COMPRESSION_RATIO=120
# Deployments kept per project before the oldest ones are pruned.
KEEP_DEPLOYMENTS=10

# ---- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
SECURITY_RETENTION_DAYS=90
