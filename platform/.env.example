# ─────────────────────────────────────────────────────────────────────────────
#  سُفرة — متغيرات البيئة
#  انسخ هذا الملف إلى .env.local ثم املأ القيم. لا تضع أي مفتاح حقيقي هنا.
# ─────────────────────────────────────────────────────────────────────────────

# العنوان العام للموقع. يُستخدم في روابط QR و Open Graph و sitemap.
# غيّره إلى دومينك الحقيقي قبل طباعة أي QR Code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# من: Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة — يتجاوز كل سياسات RLS.
# لا يُقرأ إلا داخل كود الخادم، ولا يبدأ اسمه بـ NEXT_PUBLIC_ إطلاقاً.
SUPABASE_SERVICE_ROLE_KEY=

# رابط الاتصال المباشر بقاعدة البيانات — للهجرات والبذور فقط (سكربتات npm).
# من: Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── الإحصائيات ───────────────────────────────────────────────────────────────
# ملح عشوائي طويل يُستخدم في تجزئة الزائر يومياً (خصوصية).
# ولّده بـ:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=

# ── بذور العرض التجريبي (اختياري — لسكربت db:seed فقط) ───────────────────────
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=
