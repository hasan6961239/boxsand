# ═════════════════════════════════════════════════════════════════════════════
#  سُفرة — متغيّرات البيئة
#
#  انسخ هذا الملف إلى .env.local ثم املأ القيم.
#  لا تضع أي مفتاح حقيقي في هذا الملف — فهو محفوظ في Git.
#  .env.local مستثنى من Git، وهو مكان القيم الحقيقية محلياً.
#  في الإنتاج تُضاف القيم من: Netlify ← Site configuration ← Environment variables
# ═════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
#  مطلوبة — لا يعمل المشروع بدونها
# ─────────────────────────────────────────────────────────────────────────────

# عنوان الموقع العام.
#
# ⚠ اضبطه على دومينك الحقيقي قبل طباعة أي رمز QR. الرمز يحمل هذا العنوان
#   داخله، فلو طُبع وهو localhost لن يعمل على أي هاتف، ولن يُصلَح بعد لصق
#   الملصقات على الطاولات. صفحة QR في لوحة التحكم تمنع التنزيل والطباعة
#   وتعرض تحذيراً إن لم يكن مضبوطاً.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# من: Supabase ← Project Settings ← Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# المفتاح العام. آمن في المتصفح لأن كل ما يصله محكوم بسياسات RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ مفتاح الخدمة — يتجاوز كل سياسات RLS.
#   يُقرأ في كود الخادم فقط، ولا يبدأ اسمه بـ NEXT_PUBLIC_ عمداً حتى لا
#   يُدمَج في حزمة المتصفح. من: Project Settings ← API ← service_role
SUPABASE_SERVICE_ROLE_KEY=

# ملح تجزئة الزوار اليومية (إحصائيات محترمة للخصوصية).
# ولّده بـ:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=


# ─────────────────────────────────────────────────────────────────────────────
#  للسكربتات المحلية فقط — لا يحتاجها التطبيق ولا تُضاف إلى Netlify
# ─────────────────────────────────────────────────────────────────────────────

# اتصال مباشر بقاعدة البيانات، لتطبيق الهجرات (npm run db:push).
# من: Project Settings ← Database ← Connection string ← URI
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# بذور العرض التجريبي (npm run db:seed).
# إن تركت كلمة المرور فارغة وُلّدت عشوائياً وطُبعت مرة واحدة.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=

# إنشاء مدير المنصة (npm run create:admin).
# الأفضل تمريرها كوسائط في سطر الأوامر بدل كتابتها في ملف:
#   npm run create:admin -- --email you@example.com --password "…" --name "اسمك"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=


# ─────────────────────────────────────────────────────────────────────────────
#  للاختبارات فقط — اتركها فارغة إلا عند الحاجة
# ─────────────────────────────────────────────────────────────────────────────

# تشغيل اختبارات المسارات على خادم قائم بدل بناء جديد.
# E2E_BASE_URL=http://127.0.0.1:3000

# متصفح مثبَّت مسبقاً (بيئات CI التي تأتي بنسخة مختلفة عن التي تتوقعها Playwright).
# PLAYWRIGHT_CHROMIUM_PATH=

# أداة PostgreSQL المحلية لاختبارات العزل (npm run test:db).
# SUFRA_PG_BIN=/usr/lib/postgresql/16/bin
# SUFRA_TEST_PGPORT=54329
# SUFRA_TEST_DB_URL=


# ─────────────────────────────────────────────────────────────────────────────
#  يوفّرها Netlify تلقائياً — لا تضفها بنفسك
#    URL   عنوان الموقع المنشور (يُستعمل احتياطياً إن غاب NEXT_PUBLIC_SITE_URL)
# ─────────────────────────────────────────────────────────────────────────────
